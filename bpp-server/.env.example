# Copy to .env for local development. Never commit .env or real values.
PORT=6001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/skillverify
BPP_ID=credex-bpp
BPP_URI=http://localhost:6001/beckn

# The current crypto helper generates an ephemeral key pair at process startup.
# Stable signing keys require a separate persistence and registration implementation.
\n# Comma-separated exact browser origins. Leave empty in production unless browser access is required.\nCORS_ORIGINS=http://localhost:6001,http://127.0.0.1:6001\n