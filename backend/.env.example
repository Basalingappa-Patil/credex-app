# Copy to .env for local development. Never commit .env or real values.
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/skillverify
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes

# Comma-separated exact browser origins allowed to call the API.
# In Render production, set this to the frontend URL, e.g. https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# Optional Beckn network configuration
BAP_ID=skill-verification-bap
BAP_URI=http://localhost:5001/api/beckn
BPP_URI=
GATEWAY_URI=
